    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/web3.js": "^1.98.2",
    "axios": "^1.9.0",
    "blakejs": "^1.2.1",
    "bn.js": "^5.2.2",
    "borsh": "^2.0.0",
    "buffer": "^6.0.3",
    "circomlib": "^2.0.5",
    "ethers": "^6.15.0",
    "ffjavascript": "^0.3.1",
    "snarkjs": "^0.7.5",
    "tweetnacl": "^1.0.3"
